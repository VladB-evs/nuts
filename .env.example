# Neon Serverless Postgres — SERVER-SIDE ONLY. Never prefix these with VITE_:
# Vite inlines VITE_* variables into the public JS bundle.
#
# Setup (see README):
#   1. Run neon/migrations/001..004 as the database OWNER in the Neon SQL Editor.
#   2. Give the restricted app role a password:  ALTER ROLE nuts_app PASSWORD '<long random>';
#   3. Build the two connection strings below (same host, different user).

# Restricted app role (`nuts_app`, Row Level Security applies). Used by the API,
# locally (.env) and in production (Netlify > Environment variables).
DATABASE_URL=postgresql://nuts_app:password@ep-sample-pooler-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Owner connection: migrations and maintenance ONLY. Local .env at most — NEVER set in Netlify.
# The API ignores it; it exists so you can run scripts that need to see across organizations.
DATABASE_ADMIN_URL=postgresql://neondb_owner:password@ep-sample-pooler-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------------------------------------------------------
# Neon Auth (optional). Leave BOTH unset to keep the built-in password login.
#
# Turn on Neon Auth in the Neon console (Auth tab), enable "Sign-up with Email" and
# "Verify at Sign-up" (verification code), add your site's domains as trusted domains, then
# copy the "Auth URL" into both variables. Also run neon/migrations/007_neon_auth_link.sql.
#
# NEON_AUTH_URL      server-side (Netlify > Environment variables): used to verify sign-in tokens.
# VITE_NEON_AUTH_URL browser-side, baked in at BUILD time. It is a public URL, not a secret
#                    (the "never VITE_" rule above is about database credentials).
# --------------------------------------------------------------------------------------------
# NEON_AUTH_URL=https://ep-sample-123456.neonauth.us-east-2.aws.neon.tech/neondb/auth
# VITE_NEON_AUTH_URL=https://ep-sample-123456.neonauth.us-east-2.aws.neon.tech/neondb/auth
